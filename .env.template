# =============================================================================
# PDF Tools — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in values for your environment.
# Lines starting with # are comments. Empty values disable the feature.
# =============================================================================


# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# Base URL of the site. Used for SEO canonical links and Open Graph meta tags.
# Production example: https://pdf.shining.io.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key (public, embedded in the browser widget).
# Leave empty to disable Turnstile locally. Required in production.
# Use a separate key per environment when possible.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Maximum file size shown in the UI upload hint (MB).
# Should match CONVERTER_MAX_FILE_SIZE_MB so the user sees the correct limit.
NEXT_PUBLIC_CONVERTER_MAX_FILE_SIZE_MB=20

# Maximum number of PDFs the Compress PDF UI can submit in one batch.
# Should match CONVERTER_MAX_FILES_PER_REQUEST.
NEXT_PUBLIC_CONVERTER_MAX_FILES_PER_REQUEST=20


# -----------------------------------------------------------------------------
# Nginx (Docker reverse proxy)
# -----------------------------------------------------------------------------

# Maximum request body size Nginx will accept before returning HTTP 413.
# Set slightly above CONVERTER_MAX_FILE_SIZE_MB to allow for multipart overhead.
NGINX_CLIENT_MAX_BODY_SIZE=25m

# How long Nginx waits for converter-api to respond before returning HTTP 504.
# Should be >= CONVERTER_TIMEOUT_SECONDS to let long conversions finish.
NGINX_PROXY_READ_TIMEOUT=130s


# -----------------------------------------------------------------------------
# Converter API — General
# -----------------------------------------------------------------------------

# Runtime environment: "development" or "production".
# In production, CONVERTER_INTERNAL_PROXY_TOKEN and TURNSTILE_SECRET_KEY
# become mandatory — the server will refuse to start without them.
CONVERTER_NODE_ENV=development

# IP address the converter API binds to.
# Use 127.0.0.1 for local dev (only accepts local connections).
# Use 0.0.0.0 for Docker/production (accepts connections from any interface).
CONVERTER_HOST=127.0.0.1


# -----------------------------------------------------------------------------
# Converter API — File & Conversion Limits
# -----------------------------------------------------------------------------

# Maximum uploaded file size in megabytes.
# Files exceeding this are rejected with HTTP 413.
CONVERTER_MAX_FILE_SIZE_MB=10

# Maximum number of files per single conversion request.
# Currently only 1 is supported by the frontend.
CONVERTER_MAX_FILES_PER_REQUEST=20

# Maximum number of pages in a PDF for pdf-to-word conversion.
# PDFs with more pages are rejected with HTTP 413 to prevent excessive
# processing time and memory usage.
CONVERTER_MAX_PDF_PAGES=40

# Maximum seconds allowed for a single conversion job.
# If exceeded, the conversion is killed and the client receives HTTP 504.
CONVERTER_TIMEOUT_SECONDS=80


# -----------------------------------------------------------------------------
# Converter API — Concurrency & Queue
# -----------------------------------------------------------------------------

# Maximum number of conversion jobs running in parallel.
# Additional requests are placed in a waiting queue.
CONVERTER_MAX_CONCURRENT_JOBS=1

# Maximum number of requests waiting in queue when all job slots are busy.
# Requests beyond this limit are immediately rejected with HTTP 429
# ("Server is busy"). Set to 0 to disable queueing.
CONVERTER_QUEUE_MAX_SIZE=3


# -----------------------------------------------------------------------------
# Converter API — Temp Files
# -----------------------------------------------------------------------------

# Seconds before expired temp job directories are auto-cleaned.
# A background sweep removes directories older than this value.
# Set to 0 to clean up immediately on the next sweep.
CONVERTER_TEMP_TTL_SECONDS=120

# Directory where temporary conversion files (uploads, outputs) are stored.
# Each conversion gets a unique UUID subdirectory that is removed after use.
# Use a relative path for local dev, absolute path for Docker/production.
CONVERTER_TEMP_DIR=.converter-tmp/jobs


# -----------------------------------------------------------------------------
# Converter API — CORS & Rate Limiting
# -----------------------------------------------------------------------------

# Comma-separated list of allowed request origins.
# Requests from unlisted origins are rejected with HTTP 403.
# Must include the exact origin (scheme + host + port) of the frontend.
CONVERTER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sliding window duration (seconds) for per-IP rate limiting.
# Each IP gets a fresh counter every N seconds.
CONVERTER_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum conversion requests per IP within the rate limit window.
# Excess requests are rejected with HTTP 429 ("Too many requests").
CONVERTER_RATE_LIMIT_MAX_REQUESTS=10


# -----------------------------------------------------------------------------
# Converter API — Security Tokens
# -----------------------------------------------------------------------------

# Shared secret between Nginx and converter-api (internal proxy authentication).
# Nginx sends this in the X-Internal-Proxy-Token header on every proxied request.
# Converter-api rejects requests without the correct token.
# Required in production. Leave blank locally because Next.js dev server
# rewrites requests directly to converter-api without Nginx.
CONVERTER_INTERNAL_PROXY_TOKEN=

# Cloudflare Turnstile secret key for server-side token verification.
# The converter validates the cf-turnstile-response field from the frontend
# against Cloudflare Siteverify API before starting any conversion.
# Leave empty to skip verification locally. Required in production.
TURNSTILE_SECRET_KEY=


# -----------------------------------------------------------------------------
# Production Overrides (uncomment and adjust for production .env)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://pdf.shining.io.vn
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
# NEXT_PUBLIC_CONVERTER_MAX_FILE_SIZE_MB=20
# NEXT_PUBLIC_CONVERTER_MAX_FILES_PER_REQUEST=20
# CONVERTER_NODE_ENV=production
# CONVERTER_HOST=0.0.0.0
# CONVERTER_MAX_FILE_SIZE_MB=20
# CONVERTER_MAX_FILES_PER_REQUEST=20
# CONVERTER_MAX_PDF_PAGES=80
# CONVERTER_TIMEOUT_SECONDS=120
